# build mode
NODE_ENV=development

# development server port
SERVE_PORT=8310

# content files
CONTENT_DIR=./src/content/

# template files
TEMPLATE_DIR=./src/template/
TEMPLATE_DEFAULT=default.html
# TEMPLATE_LIST=list.html
# TEMPLATE_TAG=tag.html

# CSS entry
CSS_DIR="./src/css/main.css"

# JS entry
JS_DIR="./src/js/main.js"

# CSS and JS browser target
BROWSER_TARGET="chrome140,firefox140,safari18.6"

# build directory
BUILD_DIR=./build/
BUILD_ROOT=/

# site details
SITE_LANGUAGE="en-US"
SITE_DOMAIN="https://recoveryhelp.tezos.com"
SITE_VERSION="1.0.0"
SITE_TITLE="Password Recovery Help"
SITE_DESCRIPTION="Tezos founder password recovery documentation."
SITE_AUTHOR="Tezos"
SITE_AUTHORURL="https://tezos.com/"
SITE_AUTHORX="@tezos"
SITE_WORDCOUNTSHOW=100
SITE_THEMECOLOR="#0a0c12"
